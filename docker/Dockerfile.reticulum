#
# The Reticulum side of a bridge test: RNS and the hpqc Python port. The
# pigeonhole_rns package is mounted from the checkout at run time.
# highctidh builds from source, so the image needs a C toolchain.
FROM docker.io/library/python:3.12-bookworm
RUN pip install --no-cache-dir "rns>=1.0" "hpqc>=0.0.93"
ENV PYTHONPATH=/go/katzenpost/reticulum
WORKDIR /go/katzenpost/reticulum

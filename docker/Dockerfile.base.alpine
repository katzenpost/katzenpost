ARG BASE_IMAGE=docker.io/alpine:3.21
FROM ${BASE_IMAGE}

ARG TARGETARCH
# GO_VERSION is supplied by the Makefile, which reads it from ../go.mod as
# the single source of truth for the toolchain version. It is intentionally
# not defaulted here so a direct build fails rather than pinning a stale Go.
ARG GO_VERSION

RUN adduser katzenpost --gecos "" --disabled-password

# Install build tools. Go needs a C toolchain (gcc + musl-dev) for the
# cgo components; git is used to fetch Go modules during the docker
# build.
RUN apk update && apk upgrade && \
    apk add gcc musl-dev make pv curl netcat-openbsd \
        bash perl coreutils git

# Install Go. The archive is verified against the sha256 that go.dev
# publishes for it before it is unpacked, so a corrupted or tampered
# download fails the build instead of installing a bad toolchain.
RUN set -eu; \
    test -n "$GO_VERSION" || { echo "GO_VERSION build-arg is required (the Makefile passes it from go.mod)" >&2; exit 1; }; \
    archive="go${GO_VERSION}.linux-${TARGETARCH}.tar.gz"; \
    curl -fsSL "https://go.dev/dl/?mode=json&include=all" -o /tmp/go.json; \
    checksum=$(awk -v name="\"filename\": \"$archive\"" '$0 ~ name { found=1 } found && /"sha256":/ { gsub(/[\",]/, "", $2); print $2; exit }' /tmp/go.json); \
    test -n "$checksum" || { echo "no sha256 published for $archive" >&2; exit 1; }; \
    curl -fsSL "https://go.dev/dl/$archive" -o /tmp/go.tar.gz; \
    printf '%s  %s\n' "$checksum" /tmp/go.tar.gz | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tar.gz; \
    rm -f /tmp/go.json /tmp/go.tar.gz; \
    ln -s /usr/local/go/bin/go /usr/bin/go; \
    ln -s /usr/local/go/bin/gofmt /usr/bin/gofmt
